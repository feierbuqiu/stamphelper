{
  "name": "@feierbuqiu/stamphelper",
  "version": "1.0.0",
  "description": "A privacy-first, static China Post postage and stamp-combination calculator.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "feierbuqiu",
    "url": "https://github.com/feierbuqiu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feierbuqiu/stamphelper.git"
  },
  "bugs": {
    "url": "https://github.com/feierbuqiu/stamphelper/issues"
  },
  "homepage": "https://stamphelper-cn.feierbuqiu.uk/",
  "keywords": [
    "china-post",
    "cloudflare-pages",
    "postage-calculator",
    "stamp-optimizer",
    "typescript",
    "web-worker"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "app/",
    "build/",
    "components/",
    "data/",
    "docs/",
    "lib/",
    "public/",
    "scripts/",
    "tests/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "DATA_LICENSES.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    "eslint.config.mjs",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run data:generate",
    "dev": "vinext dev",
    "prebuild": "npm run data:generate",
    "build": "vinext build",
    "pages:stage": "npm run build && node scripts/stage-cloudflare-pages.mjs",
    "start": "vinext start",
    "data:generate": "node scripts/generate-postage-data.mjs && node scripts/generate-destination-data.mjs",
    "test": "npm run build && node scripts/stage-cloudflare-pages.mjs && tsx --test tests/stamp-solver.test.ts tests/stamp-profile.test.ts tests/postage-calculator.test.ts tests/destination-search.test.ts && node --test tests/rendered-html.test.mjs tests/performance-budget.test.mjs tests/repository-integrity.test.mjs tests/security-headers.test.mjs tests/ux-regressions.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run lint && npm test",
    "pack:inspect": "npm pack --dry-run",
    "release:verify": "node scripts/verify-release-version.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "pinyin-pro": "^3.28.2",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "world-countries": "^5.1.0",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
